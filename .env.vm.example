# RippleBot — VM .env template (managed on the VM by DevOps at /opt/ripplebot/.env).
# Copy to .env and fill in. NEVER commit the real .env. Mirrors the vars the app reads.

# ── Vector store (default: embedded Chroma in the data volume) ────────────────
VECTOR_BACKEND=chroma
# To use Postgres+pgvector instead, uncomment the postgres service in
# docker-compose.yml and set:
# VECTOR_BACKEND=pgvector
# POSTGRES_URI=postgresql://ripplebot:CHANGE_ME@postgres:5432/ripplebot
# POSTGRES_PASSWORD=CHANGE_ME

# ── Embeddings + standard-pipeline LLMs ───────────────────────────────────────
VOYAGE_API_KEY2=
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Agentic layer (Claude brain + help center) ────────────────────────────────
AGENTIC_MODE=on
ANTHROPIC_API_KEY=
DOCUMENT360_API_KEY=

# ── Live operational DB (read-only; reachable from the VM via the VPC) ─────────
DB_HOST=10.118.0.3
DB_PORT=3306
DB_USER=cu_shobit.shah
DB_PASSWORD=
# DB_NAME optional — the fan-out discovers tenant schemas itself
# LIVE_DB_SCHEMAS=portal,buddyto,axis_cp   # optional allowlist to bound the fan-out

# ── Auth: Google OAuth restricted to RippleHire employees ─────────────────────
# (ported from infosec-tool — only @ripplehire.com Google accounts can sign in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://chatbot.ripplehire.com/api/auth/callback
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ALLOWED_DOMAIN=ripplehire.com
FRONTEND_URL=https://chatbot.ripplehire.com

# ── Web ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://chatbot.ripplehire.com
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=
